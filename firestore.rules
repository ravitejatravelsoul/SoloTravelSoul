rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Default: deny everything ──────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }

    // ── Users ──────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // ── Trips ─────────────────────────────────────────────────────
      match /trips/{tripId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;

        // ── Itinerary days ─────────────────────────────────────────
        match /itinerary/{dayId} {
          allow read, write: if request.auth != null && request.auth.uid == userId;
        }

        // ── Packing checklist ──────────────────────────────────
        match /checklist/{itemId} {
          allow read, write: if request.auth != null && request.auth.uid == userId;
        }

        // ── Trip reminder preferences ───────────────────────────
        match /reminders/{doc} {
          allow read, write: if request.auth != null && request.auth.uid == userId;
        }
      }

      // ── Saved places ───────────────────────────────────────────────
      match /saved_places/{placeId} {
        allow read, delete: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null
          && request.auth.uid == userId
          && request.resource.data.userId == request.auth.uid;
        allow update: if request.auth != null && request.auth.uid == userId;
      }
    }

    // ── Notifications ─────────────────────────────────────────────────
    match /notifications/{notificationId} {
      allow read: if request.auth != null
        && request.auth.uid == resource.data.userId;

      allow update: if request.auth != null
        && request.auth.uid == resource.data.userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead'])
        && request.resource.data.isRead is bool;
    }

    // ── User place reviews ────────────────────────────────────────────
    match /user_place_reviews/{reviewId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.userId;
      allow update, delete: if request.auth != null
        && request.auth.uid == resource.data.userId;
    }

    // ── User lookup — minimal public data for chat search ────────────
    // Written by owner on profile create/update.
    // Any authenticated user can read for email-based user discovery.
    match /userLookup/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // ── Direct chats ─────────────────────────────────────────────────
    match /direct_chats/{chatId} {
      // resource == null when the document does not yet exist.
      // Allowing authenticated reads on non-existing docs is safe:
      // the SDK returns exists()=false with no data, so nothing is exposed.
      allow read: if request.auth != null
        && (resource == null || request.auth.uid in resource.data.participants);
      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.participants.size() == 2;
      // Participants can update metadata (lastMessage, unreadCounts).
      // The participants array itself must not change after creation.
      allow update: if request.auth != null
        && request.auth.uid in resource.data.participants
        && request.resource.data.participants == resource.data.participants;

      match /messages/{messageId} {
        allow read: if request.auth != null
          && request.auth.uid in
             get(/databases/$(database)/documents/direct_chats/$(chatId)).data.participants;
        allow create: if request.auth != null
          && request.auth.uid in
             get(/databases/$(database)/documents/direct_chats/$(chatId)).data.participants
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 1000;
        // Messages are immutable once sent.
        allow update, delete: if false;
      }
    }

    // ── Groups ────────────────────────────────────────────────────────
    match /groups/{groupId} {
      allow read: if request.auth != null
        && request.auth.uid in resource.data.members;
      // Creator must be a member, and must set themselves as createdBy.
      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.members
        && request.auth.uid == request.resource.data.createdBy;
      // Any member can update (for lastMessage, unreadCounts updates).
      allow update: if request.auth != null
        && request.auth.uid in resource.data.members;
      allow delete: if request.auth != null
        && request.auth.uid == resource.data.createdBy;

      match /messages/{messageId} {
        allow read: if request.auth != null
          && request.auth.uid in
             get(/databases/$(database)/documents/groups/$(groupId)).data.members;
        allow create: if request.auth != null
          && request.auth.uid in
             get(/databases/$(database)/documents/groups/$(groupId)).data.members
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 1000;
        allow update, delete: if false;
      }
    }

    // ── Places cache ──────────────────────────────────────────────────
    match /places_cache/{placeId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.data.id == placeId
        && request.resource.data.source in ['foursquare', 'manual'];
    }
  }
}
