rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Persistent account-deletion barrier. Once deletion of an account starts
    // (accountDeletions/{uid} exists), no token for that UID can write anything
    // again — including tokens still valid on other devices. Deletion itself,
    // and its retries, run server-side with Admin credentials.
    // ── Moderation ─────────────────────────────────────────────────────
    // moderators/{uid} is managed by the project owner (console/Admin only).
    function isModerator() {
      return request.auth != null && exists(/databases/$(database)/documents/moderators/$(request.auth.uid));
    }
    function suspended(uid) {
      return exists(/databases/$(database)/documents/accountSuspensions/$(uid));
    }
    // Server-side content filter for public text; pattern generated from
    // packages/shared/src/moderation.ts (BLOCKED_TERMS_RULES_PATTERN) — a
    // release test fails if they differ.
    function clean(value) {
      return !(value is string) || !value.matches('(?is).*\\b(fuck\\w*|motherfuck\\w*|cunts?|pussy|porn\\w*|blowjobs?|handjobs?|rap(e|ist|ists)|p(a)?edophil\\w*|nigg(er|ers|a|as)|faggots?|fags|retards?|kikes?|trann(y|ies)|whores?|sluts?|kill yourself|kys)\\b.*');
    }
    function cleanFields(data, keys) {
      return clean(data.get(keys[0], null)) && (keys.size() < 2 || clean(data.get(keys[1], null)))
        && (keys.size() < 3 || clean(data.get(keys[2], null))) && (keys.size() < 4 || clean(data.get(keys[3], null)));
    }
    // A reporter's +1 on a post/journal, backed by their report created in the
    // same write. At the hide threshold a public item must become 'under_review'.
    function reportStep(id, type) {
      let report = /databases/$(database)/documents/reports/$(type + '___' + id + '___' + request.auth.uid);
      let next = request.resource.data.get('reportCount', 0);
      let keys = request.resource.data.diff(resource.data).affectedKeys();
      let mustHide = next >= 3 && resource.data.get('visibility', 'public') == 'public';
      return !exists(report) && existsAfter(report)
        && next == resource.data.get('reportCount', 0) + 1
        && (mustHide
          ? keys.hasOnly(['reportCount', 'visibility']) && request.resource.data.visibility == 'under_review'
          : keys.hasOnly(['reportCount']));
    }
    function moderated() {
      return resource.data.get('visibility', 'public') in ['under_review', 'removed'];
    }
    // Moderated content (under_review / removed) is frozen for its author: it
    // can be archived or unarchived, but not edited, restored, replaced or
    // deleted (deleting would let it be recreated at the same ID with a clean
    // record). Account deletion runs with Admin credentials and still removes it.
    function authorMayEdit() {
      return !moderated()
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isArchived', 'updatedAt']);
    }
    // POST /moderation/remove-media claims the item (mediaRemoval) before
    // deleting objects; visibility cannot change until it finishes or its
    // lease lapses, so a restore can never be undone by the cleanup.
    function mediaRemovalActive() {
      let removal = resource.data.get('mediaRemoval', null);
      return removal != null && removal.get('state', '') == 'in_progress'
        && removal.get('leaseUntilMs', 0) > request.time.toMillis();
    }
    function moderatorSetsVisibility() {
      return isModerator() && !mediaRemovalActive()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['visibility', 'reportCount', 'moderatedBy', 'moderatedAt'])
        && request.resource.data.visibility in ['public', 'private', 'under_review', 'removed']
        && request.resource.data.get('reportCount', 0) in [0, resource.data.get('reportCount', 0)]
        && request.resource.data.moderatedBy == request.auth.uid && request.resource.data.moderatedAt == request.time;
    }

    function deleting(uid) {
      return exists(/databases/$(database)/documents/accountDeletions/$(uid));
    }
    // Writes are refused for accounts being deleted or suspended by a moderator.
    function notDeleting() {
      return request.auth == null || (!deleting(request.auth.uid) && !suspended(request.auth.uid));
    }
    // No new inbound relationships (likes, saves, follows, comments, replies,
    // memberships, join requests) may target an account being deleted.
    // Group membership lists cannot be iterated in rules, so each write may add
    // at most 8 members, each checked against the barrier (createGroup adds
    // larger groups in chunks). Unchanged members are not re-checked.
    function noDeletingIn(uids) {
      return uids.size() <= 8
        && (uids.size() <= 0 || !deleting(uids[0])) && (uids.size() <= 1 || !deleting(uids[1]))
        && (uids.size() <= 2 || !deleting(uids[2])) && (uids.size() <= 3 || !deleting(uids[3]))
        && (uids.size() <= 4 || !deleting(uids[4])) && (uids.size() <= 5 || !deleting(uids[5]))
        && (uids.size() <= 6 || !deleting(uids[6])) && (uids.size() <= 7 || !deleting(uids[7]));
    }
    function authorOf(collectionName, id) {
      return get(/databases/$(database)/documents/$(collectionName)/$(id)).data.authorId;
    }

    // Ownership is enforced on relationship documents AND their atomic counter
    // updates. A numeric +/-1 change by itself is not evidence of an action.
    function unblocked(a, b) {
      return a == b || (!exists(/databases/$(database)/documents/blocks/$(a)/blocked/$(b))
        && !exists(/databases/$(database)/documents/blocks/$(b)/blocked/$(a)));
    }
    function visible(data) {
      return request.auth != null && (data.authorId == request.auth.uid
        || (data.get('visibility', 'private') == 'public' && !data.get('isArchived', false))
        || isModerator());
    }
    function readablePost(id) {
      return exists(/databases/$(database)/documents/travelPosts/$(id))
        && visible(get(/databases/$(database)/documents/travelPosts/$(id)).data);
    }
    function likeKind(data) {
      return data.get('targetType', exists(/databases/$(database)/documents/travelPosts/$(data.postId)) ? 'post' : 'journal');
    }
    function readableLike(data) {
      return (likeKind(data) == 'post' && readablePost(data.postId))
        || (likeKind(data) == 'journal'
          && exists(/databases/$(database)/documents/travelJournals/$(data.postId))
          && visible(get(/databases/$(database)/documents/travelJournals/$(data.postId)).data));
    }
    function counterStep(key, keys) {
      let next = request.resource.data.get(key, null);
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys)
        && next is int && next >= 0
        && (next - resource.data.get(key, 0)) in [1, -1];
    }
    function edgeTransition(path, delta) {
      return (delta == 1 && !exists(path) && existsAfter(path))
        || (delta == -1 && exists(path) && !existsAfter(path));
    }
    function linkedCounter(collectionName, id, key, delta) {
      let path = /databases/$(database)/documents/$(collectionName)/$(id);
      return exists(path) && existsAfter(path)
        && getAfter(path).data.get(key, 0) == get(path).data.get(key, 0) + delta;
    }
    function likeCounter(id, kind) {
      let edge = /databases/$(database)/documents/postLikes/$(id + '___' + request.auth.uid);
      let delta = request.resource.data.get('likeCount', 0) - resource.data.get('likeCount', 0);
      return counterStep('likeCount', ['likeCount']) && edgeTransition(edge, delta)
        && ((delta == 1 && likeKind(getAfter(edge).data) == kind)
          || (delta == -1 && likeKind(get(edge).data) == kind));
    }
    function saveCounter(id) {
      let edge = /databases/$(database)/documents/savedPosts/$(request.auth.uid + '___' + id);
      let delta = request.resource.data.get('saveCount', 0) - resource.data.get('saveCount', 0);
      return counterStep('saveCount', ['saveCount']) && edgeTransition(edge, delta);
    }
    function followerCounter(uid) {
      let edge = /databases/$(database)/documents/follows/$(request.auth.uid + '___' + uid);
      let delta = request.resource.data.get('followersCount', 0) - resource.data.get('followersCount', 0);
      return counterStep('followersCount', ['followersCount']) && edgeTransition(edge, delta);
    }
    function followingCounter(uid) {
      let target = request.resource.data.get('lastFollowingId', '');
      let edge = /databases/$(database)/documents/follows/$(uid + '___' + target);
      let delta = request.resource.data.get('followingCount', 0) - resource.data.get('followingCount', 0);
      return request.auth.uid == uid && target is string && target != uid
        && counterStep('followingCount', ['followingCount', 'lastFollowingId']) && edgeTransition(edge, delta);
    }
    function commentTransition(id, postId, delta) {
      let path = /databases/$(database)/documents/postComments/$(id);
      let next = getAfter(path);
      return next != null && next.data.authorId == request.auth.uid && next.data.postId == postId
        && ((delta == 1 && !exists(path) && next.data.isDeleted == false)
          || (delta == -1 && exists(path) && get(path).data.isDeleted == false && next.data.isDeleted == true));
    }
    function commentCounter(postId) {
      let id = request.resource.data.get('lastCommentId', '');
      let delta = request.resource.data.get('commentCount', 0) - resource.data.get('commentCount', 0);
      return counterStep('commentCount', ['commentCount', 'lastCommentId', 'updatedAt'])
        && request.resource.data.updatedAt == request.time && id is string
        && commentTransition(id, postId, delta);
    }
    function replyCounter(parentId) {
      let id = request.resource.data.get('lastReplyId', '');
      let delta = request.resource.data.get('replyCount', 0) - resource.data.get('replyCount', 0);
      return counterStep('replyCount', ['replyCount', 'lastReplyId']) && id is string
        && commentTransition(id, resource.data.postId, delta)
        && getAfter(/databases/$(database)/documents/postComments/$(id)).data.parentCommentId == parentId;
    }
    function postCommentLinked(id, postId, delta) {
      return linkedCounter('travelPosts', postId, 'commentCount', delta)
        && getAfter(/databases/$(database)/documents/travelPosts/$(postId)).data.lastCommentId == id;
    }
    function replyLinked(data, id, delta) {
      let parent = data.get('parentCommentId', null);
      return parent == null || (linkedCounter('postComments', parent, 'replyCount', delta)
        && getAfter(/databases/$(database)/documents/postComments/$(parent)).data.lastReplyId == id
        && get(/databases/$(database)/documents/postComments/$(parent)).data.postId == data.postId);
    }
    function followLinked(data, delta) {
      return ((!exists(/databases/$(database)/documents/publicProfiles/$(data.followingId)) && delta == -1)
          || linkedCounter('publicProfiles', data.followingId, 'followersCount', delta))
        && ((!exists(/databases/$(database)/documents/publicProfiles/$(data.followerId)) && delta == -1)
          || (linkedCounter('publicProfiles', data.followerId, 'followingCount', delta)
            && getAfter(/databases/$(database)/documents/publicProfiles/$(data.followerId)).data.lastFollowingId == data.followingId));
    }

    // ── Default: deny everything ──────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }

    // ── Users ──────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if notDeleting() && (request.auth != null && request.auth.uid == userId);

      // ── Trips ─────────────────────────────────────────────────────
      match /trips/{tripId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if notDeleting() && (request.auth != null && request.auth.uid == userId);

        // ── Itinerary days ─────────────────────────────────────────
        match /itinerary/{dayId} {
          allow read: if request.auth != null && request.auth.uid == userId;
          allow write: if notDeleting() && (request.auth != null && request.auth.uid == userId);
        }

        // ── Packing checklist ──────────────────────────────────
        match /checklist/{itemId} {
          allow read: if request.auth != null && request.auth.uid == userId;
          allow write: if notDeleting() && (request.auth != null && request.auth.uid == userId);
        }

        // ── Trip reminder preferences ───────────────────────────
        match /reminders/{doc} {
          allow read: if request.auth != null && request.auth.uid == userId;
          allow write: if notDeleting() && (request.auth != null && request.auth.uid == userId);
        }
      }

      // ── Saved places ───────────────────────────────────────────────
      match /saved_places/{placeId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow delete: if notDeleting() && (request.auth != null && request.auth.uid == userId);
        allow create: if notDeleting() && (request.auth != null
          && request.auth.uid == userId
          && request.resource.data.userId == request.auth.uid);
        allow update: if notDeleting() && (request.auth != null && request.auth.uid == userId);
      }
    }

    // ── Notifications ─────────────────────────────────────────────────
    match /notifications/{notificationId} {
      allow read: if request.auth != null
        && request.auth.uid == resource.data.userId;

      allow update: if notDeleting() && (request.auth != null
        && request.auth.uid == resource.data.userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead'])
        && request.resource.data.isRead is bool);
    }

    // ── User place reviews ────────────────────────────────────────────
    match /user_place_reviews/{reviewId} {
      allow read: if request.auth != null;
      allow create: if notDeleting() && (request.auth != null
        && request.auth.uid == request.resource.data.userId);
      allow update, delete: if notDeleting() && (request.auth != null
        && request.auth.uid == resource.data.userId);
    }

    // ── User lookup — minimal public data for chat search ────────────
    // Written by owner on profile create/update.
    // Any authenticated user can read for email-based user discovery.
    match /userLookup/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      // Validate that the stored email matches the caller's verified auth token email.
      // Prevents a user from writing another user's email into their own lookup entry.
      allow create, update: if notDeleting() && (request.auth != null
        && request.auth.uid == uid
        && request.resource.data.email.lower() == request.auth.token.email.lower());
      allow delete: if notDeleting() && (request.auth != null && request.auth.uid == uid);
    }

    // Exact-address lookup: get is permitted, list is never permitted. IDs
    // escape % and / consistently with emailLookupId in the client.
    match /userLookupByEmail/{address} {
      allow get: if request.auth != null && (resource == null || unblocked(request.auth.uid, resource.data.uid));
      allow list: if false;
      allow create, update: if notDeleting() && (request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email.lower()
        && address == request.auth.token.email.lower().replace('%', '%25').replace('/', '%2F')
        && (resource == null || resource.data.uid == request.auth.uid));
      allow delete: if notDeleting() && (request.auth != null && (resource != null ? resource.data.uid == request.auth.uid
        : address == request.auth.token.email.lower().replace('%', '%25').replace('/', '%2F')));
    }

    // ── Direct chats ─────────────────────────────────────────────────
    match /direct_chats/{chatId} {
      // resource == null when the document does not yet exist.
      // Allowing authenticated reads on non-existing docs is safe:
      // the SDK returns exists()=false with no data, so nothing is exposed.
      allow read: if request.auth != null
        && (resource == null || request.auth.uid in resource.data.participants);
      allow create: if notDeleting() && (request.auth != null
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.participants.size() == 2
        && request.resource.data.participants[0] != request.resource.data.participants[1]
        && unblocked(request.resource.data.participants[0], request.resource.data.participants[1])
        && !deleting(request.resource.data.participants[0]) && !deleting(request.resource.data.participants[1]));
      // A preview must point to the message created in this same transaction.
      function sentMessage() {
        let id = request.resource.data.lastMessage.messageId;
        let message = /databases/$(database)/documents/direct_chats/$(chatId)/messages/$(id);
        let other = resource.data.participants[0] == request.auth.uid
          ? resource.data.participants[1] : resource.data.participants[0];
        return unblocked(request.auth.uid, other) && !deleting(other) && !exists(message) && existsAfter(message)
          && getAfter(message).data.senderId == request.auth.uid
          && request.resource.data.lastMessage.senderId == request.auth.uid
          && request.resource.data.lastMessage.text == getAfter(message).data.text
          && request.resource.data.lastMessage.sentAt == request.time
          && request.resource.data.updatedAt == request.time
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage', 'updatedAt', 'unreadCounts'])
          && request.resource.data.unreadCounts.diff(resource.data.unreadCounts).affectedKeys().hasOnly([other])
          && request.resource.data.unreadCounts.get(other, 0) == resource.data.unreadCounts.get(other, 0) + 1;
      }
      function markRead() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['unreadCounts'])
          && request.resource.data.unreadCounts.diff(resource.data.unreadCounts).affectedKeys().hasOnly([request.auth.uid])
          && request.resource.data.unreadCounts.get(request.auth.uid, -1) == 0;
      }
      allow update: if notDeleting() && (request.auth != null && request.auth.uid in resource.data.participants
        && (markRead() || sentMessage()));

      match /messages/{messageId} {
        allow read: if request.auth != null
          && request.auth.uid in
             get(/databases/$(database)/documents/direct_chats/$(chatId)).data.participants;
        allow create: if notDeleting() && (request.auth != null
          && request.auth.uid in
             get(/databases/$(database)/documents/direct_chats/$(chatId)).data.participants
          && unblocked(get(/databases/$(database)/documents/direct_chats/$(chatId)).data.participants[0],
            get(/databases/$(database)/documents/direct_chats/$(chatId)).data.participants[1])
          && !deleting(get(/databases/$(database)/documents/direct_chats/$(chatId)).data.participants[0])
          && !deleting(get(/databases/$(database)/documents/direct_chats/$(chatId)).data.participants[1])
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 1000
          && request.resource.data.sentAt == request.time
          && getAfter(/databases/$(database)/documents/direct_chats/$(chatId)).data.lastMessage.messageId == messageId);
        // Messages are immutable once sent.
        allow update, delete: if false;
      }
    }

    // ── Groups ────────────────────────────────────────────────────────
    match /groups/{groupId} {
      allow read: if request.auth != null
        && request.auth.uid in resource.data.members;
      // Creator must be a member, and must set themselves as createdBy.
      allow create: if notDeleting() && (request.auth != null
        && request.auth.uid in request.resource.data.members
        && request.auth.uid == request.resource.data.createdBy
        && noDeletingIn(request.resource.data.members));
      // Creator can update any field (rename group, add/remove members, etc.)
      allow update: if notDeleting() && (request.auth != null
        && request.auth.uid == resource.data.createdBy
        && noDeletingIn(request.resource.data.members.removeAll(resource.data.members)));
      // Members (non-creator) can only write chat metadata, or remove themselves from the group.
      allow update: if notDeleting() && (request.auth != null
        && request.auth.uid in resource.data.members
        && (
          request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['lastMessage', 'unreadCounts', 'updatedAt'])
          || (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
            && request.resource.data.members == resource.data.members.removeAll([request.auth.uid])
          )
        ));
      allow delete: if notDeleting() && (request.auth != null
        && request.auth.uid == resource.data.createdBy);

      match /messages/{messageId} {
        allow read: if request.auth != null
          && request.auth.uid in
             get(/databases/$(database)/documents/groups/$(groupId)).data.members;
        allow create: if notDeleting() && (request.auth != null
          && request.auth.uid in
             get(/databases/$(database)/documents/groups/$(groupId)).data.members
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 1000);
        allow update, delete: if false;
      }
    }

    // ── Places cache ──────────────────────────────────────────────────
    match /places_cache/{placeId} {
      allow read: if request.auth != null;
      allow write: if notDeleting() && (request.auth != null
        && request.resource.data.id == placeId
        && request.resource.data.source in ['foursquare', 'manual']);
    }

    // ── Community: Public Profiles ────────────────────────────────────
    match /publicProfiles/{uid} {
      allow get: if request.auth != null && (request.auth.uid == uid
        || (resource != null && resource.data.get('profileVisibility', 'public') == 'public' && unblocked(request.auth.uid, uid)));
      allow list: if request.auth != null && resource.data.get('profileVisibility', 'public') == 'public';
      allow create: if notDeleting() && (request.auth != null && request.auth.uid == uid
        && request.resource.data.get('followersCount', 0) == 0 && request.resource.data.get('followingCount', 0) == 0
        && cleanFields(request.resource.data, ['displayName', 'bio', 'currentCity']));
      allow delete: if notDeleting() && (request.auth != null && request.auth.uid == uid);
      allow update: if notDeleting() && (request.auth != null && (
        (request.auth.uid == uid && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['followersCount', 'followingCount'])
          && cleanFields(request.resource.data, ['displayName', 'bio', 'currentCity']))
        || followerCounter(uid) || followingCounter(uid)));
    }

    // ── Community: Public Trips ───────────────────────────────────────
    match /publicTrips/{tripId} {
      allow read: if request.auth != null;
      allow create: if notDeleting() && (request.auth != null
        && request.resource.data.ownerUid == request.auth.uid
        && cleanFields(request.resource.data, ['title', 'description', 'destination']));
      allow update: if notDeleting() && (request.auth != null
        && resource != null
        && resource.data.ownerUid == request.auth.uid
        && cleanFields(request.resource.data, ['title', 'description', 'destination']));
      // Allow delete even when doc doesn't exist (batch delete when trip goes private).
      allow delete: if notDeleting() && (request.auth != null
        && (resource == null
            || resource.data.ownerUid == request.auth.uid));
    }

    // ── Community: Trip Members subcollection ────────────────────────
    // Write is restricted to the trip owner. Two-phase check handles the
    // batch that creates publicTrips + member doc at the same time.
    match /trips/{tripId}/members/{memberId} {
      allow read: if request.auth != null;
      allow create: if notDeleting() && !deleting(memberId) && (request.auth != null && (
        // Phase 1 — initial trip publication: publicTrip doesn't exist yet
        // (same-batch create), so verify via the user's private trips subcollection.
        (!exists(/databases/$(database)/documents/publicTrips/$(tripId))
          && request.resource.data.role == 'owner'
          && request.resource.data.uid == request.auth.uid
          && exists(/databases/$(database)/documents/users/$(request.auth.uid)/trips/$(tripId)))
        ||
        // Phase 2 — join-request approval: publicTrip already exists.
        (exists(/databases/$(database)/documents/publicTrips/$(tripId))
          && get(/databases/$(database)/documents/publicTrips/$(tripId)).data.ownerUid == request.auth.uid)
      ));
      allow delete: if notDeleting() && (request.auth != null && (
        memberId == request.auth.uid   // member removing themselves
        || (exists(/databases/$(database)/documents/publicTrips/$(tripId))
            && get(/databases/$(database)/documents/publicTrips/$(tripId)).data.ownerUid == request.auth.uid)
      ));
      allow update: if false;
    }

    // ── Community: Trip Join Requests ─────────────────────────────────
    match /tripJoinRequests/{requestId} {
      allow create: if notDeleting() && !deleting(request.resource.data.ownerUid) && (request.auth != null
        && request.resource.data.requestorUid == request.auth.uid
        && request.resource.data.ownerUid != request.auth.uid
        && request.resource.data.status == 'pending');
      // Allow read when resource == null so getTripJoinRequestStatus returns null
      // instead of throwing permission-denied for trips with no previous request.
      allow read: if request.auth != null
        && (resource == null
            || resource.data.ownerUid == request.auth.uid
            || resource.data.requestorUid == request.auth.uid);
      allow update: if notDeleting() && (request.auth != null
        && resource != null
        && (
          (resource.data.ownerUid == request.auth.uid
            && request.resource.data.status in ['approved', 'rejected'])
          || (resource.data.requestorUid == request.auth.uid
              && request.resource.data.status == 'cancelled')
        ));
      allow delete: if false;
    }

    // ── Community: Travel Groups ──────────────────────────────────────
    match /travelGroups/{groupId} {
      // List/get: public groups readable by all auth users; private groups by owner only.
      allow read: if request.auth != null
        && (resource == null
            || resource.data.visibility == 'public'
            || resource.data.ownerUid == request.auth.uid);
      allow create: if notDeleting() && (request.auth != null
        && request.resource.data.ownerUid == request.auth.uid
        && cleanFields(request.resource.data, ['name', 'description', 'rules', 'destination']));
      allow update: if notDeleting() && (request.auth != null
        && resource != null
        && resource.data.ownerUid == request.auth.uid
        && cleanFields(request.resource.data, ['name', 'description', 'rules', 'destination']));
      allow delete: if notDeleting() && (request.auth != null
        && resource != null
        && resource.data.ownerUid == request.auth.uid);

      // Group members: restricted to group owner; two-phase check mirrors trip members.
      match /members/{memberId} {
        allow read: if request.auth != null;
        allow create: if notDeleting() && !deleting(memberId) && (request.auth != null && (
          // Phase 1 — group creation batch: group doc doesn't exist yet in Firestore.
          (!exists(/databases/$(database)/documents/travelGroups/$(groupId))
            && request.resource.data.role == 'owner'
            && request.resource.data.uid == request.auth.uid)
          ||
          // Phase 2 — join-request approval: group already exists.
          (exists(/databases/$(database)/documents/travelGroups/$(groupId))
            && get(/databases/$(database)/documents/travelGroups/$(groupId)).data.ownerUid == request.auth.uid)
        ));
        allow delete: if notDeleting() && (request.auth != null && (
          memberId == request.auth.uid   // member leaving themselves
          || (exists(/databases/$(database)/documents/travelGroups/$(groupId))
              && get(/databases/$(database)/documents/travelGroups/$(groupId)).data.ownerUid == request.auth.uid)
        ));
        allow update: if false;
      }
    }

    // ── Community: Group Join Requests ────────────────────────────────
    match /groupJoinRequests/{requestId} {
      allow create: if notDeleting() && !deleting(request.resource.data.ownerUid) && (request.auth != null
        && request.resource.data.requestorUid == request.auth.uid
        && request.resource.data.ownerUid != request.auth.uid
        && request.resource.data.status == 'pending');
      // resource == null guard matches tripJoinRequests pattern.
      allow read: if request.auth != null
        && (resource == null
            || resource.data.ownerUid == request.auth.uid
            || resource.data.requestorUid == request.auth.uid);
      allow update: if notDeleting() && (request.auth != null
        && resource != null
        && (
          (resource.data.ownerUid == request.auth.uid
            && request.resource.data.status in ['approved', 'rejected'])
          || (resource.data.requestorUid == request.auth.uid
              && request.resource.data.status == 'cancelled')
        ));
      allow delete: if false;
    }

    // ── Community: Nearby Travelers ───────────────────────────────────
    match /nearbyTravelers/{uid} {
      allow read: if request.auth != null;
      allow write: if notDeleting() && (request.auth != null && request.auth.uid == uid);
    }

    // ── Community: Activity Feed ──────────────────────────────────────
    match /activityFeed/{feedItemId} {
      allow read: if request.auth != null;
      allow create: if notDeleting() && (request.auth != null
        && request.resource.data.actorUid == request.auth.uid);
      allow delete: if notDeleting() && (request.auth != null
        && resource.data.actorUid == request.auth.uid);
      allow update: if false;
    }

    // ── Community: Blocks ─────────────────────────────────────────────
    match /blocks/{uid}/blocked/{blockedUid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if notDeleting() && (request.auth != null && request.auth.uid == uid);
    }

    // ── Community: Reports ────────────────────────────────────────────
    // One report per reporter and target ({type}___{targetId}___{reporterUid}).
    // Reports on posts/journals increment the target's reportCount in the same
    // write (reportStep); only moderators can list, read others' or review.
    match /reports/{reportId} {
      allow create: if notDeleting() && (request.auth != null
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.targetType in ['user', 'trip', 'group', 'message', 'post', 'journal', 'comment']
        && request.resource.data.targetId is string
        && reportId == request.resource.data.targetType + '___' + request.resource.data.targetId + '___' + request.auth.uid
        && (!(request.resource.data.targetType in ['post', 'journal'])
          || linkedCounter(request.resource.data.targetType == 'post' ? 'travelPosts' : 'travelJournals',
               request.resource.data.targetId, 'reportCount', 1)));
      allow get: if request.auth != null && (resource == null || resource.data.reporterUid == request.auth.uid || isModerator());
      allow list: if isModerator();
      allow update: if notDeleting() && isModerator()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'resolution', 'reviewedBy', 'reviewedAt'])
        && request.resource.data.status in ['reviewing', 'actioned', 'dismissed']
        && request.resource.data.reviewedBy == request.auth.uid && request.resource.data.reviewedAt == request.time;
      allow delete: if false;
    }

    // ── Moderation roles and suspensions ──────────────────────────────
    match /moderators/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, write: if false;
    }
    match /accountSuspensions/{uid} {
      allow get: if request.auth != null && (request.auth.uid == uid || isModerator());
      allow list: if isModerator();
      allow create: if notDeleting() && isModerator() && uid != request.auth.uid
        && request.resource.data.suspendedBy == request.auth.uid && request.resource.data.createdAt == request.time
        && request.resource.data.reason is string && request.resource.data.reason.size() <= 500;
      allow delete: if notDeleting() && isModerator();
      allow update: if false;
    }

    // ── Phase 2: Travel Posts and Journals ────────────────────────────
    match /travelPosts/{postId} {
      allow read: if visible(resource.data);
      allow create: if notDeleting() && (request.auth != null && request.resource.data.authorId == request.auth.uid
        && request.resource.data.likeCount == 0 && request.resource.data.commentCount == 0 && request.resource.data.saveCount == 0
        && request.resource.data.get('reportCount', 0) == 0
        && !(request.resource.data.get('visibility', 'public') in ['under_review', 'removed'])
        && cleanFields(request.resource.data, ['caption', 'body', 'location', 'country']));
      allow update: if notDeleting() && (request.auth != null && (
        (resource.data.authorId == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['caption', 'body', 'location', 'country', 'hashtags', 'visibility', 'images', 'updatedAt', 'isArchived'])
          && authorMayEdit() && cleanFields(request.resource.data, ['caption', 'body', 'location', 'country']))
        || likeCounter(postId, 'post') || saveCounter(postId) || commentCounter(postId)
        || reportStep(postId, 'post') || moderatorSetsVisibility()));
      allow delete: if notDeleting() && (request.auth != null && resource.data.authorId == request.auth.uid && !moderated());
    }
    match /travelJournals/{journalId} {
      allow read: if visible(resource.data);
      allow create: if notDeleting() && (request.auth != null && request.resource.data.authorId == request.auth.uid
        && request.resource.data.likeCount == 0 && request.resource.data.commentCount == 0 && request.resource.data.saveCount == 0
        && request.resource.data.get('reportCount', 0) == 0
        && !(request.resource.data.get('visibility', 'public') in ['under_review', 'removed'])
        && cleanFields(request.resource.data, ['title', 'subtitle', 'body', 'location']));
      allow update: if notDeleting() && (request.auth != null && (
        (resource.data.authorId == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['title', 'subtitle', 'body', 'coverImageURL', 'images', 'location', 'country', 'hashtags', 'visibility', 'readTimeMinutes', 'updatedAt', 'isArchived'])
          && authorMayEdit() && cleanFields(request.resource.data, ['title', 'subtitle', 'body', 'location']))
        || likeCounter(journalId, 'journal') || reportStep(journalId, 'journal') || moderatorSetsVisibility()));
      allow delete: if notDeleting() && (request.auth != null && resource.data.authorId == request.auth.uid && !moderated());
    }
    match /postLikes/{likeId} {
      allow get: if request.auth != null && (resource == null || resource.data.userId == request.auth.uid || readableLike(resource.data));
      allow list: if request.auth != null && readableLike(resource.data);
      allow create: if notDeleting() && (request.auth != null && request.resource.data.userId == request.auth.uid
        && likeId == request.resource.data.postId + '___' + request.auth.uid && readableLike(request.resource.data)
        && ((likeKind(request.resource.data) == 'post'
          && unblocked(request.auth.uid, get(/databases/$(database)/documents/travelPosts/$(request.resource.data.postId)).data.authorId)
          && !deleting(authorOf('travelPosts', request.resource.data.postId))
          && linkedCounter('travelPosts', request.resource.data.postId, 'likeCount', 1))
          || (likeKind(request.resource.data) == 'journal'
            && unblocked(request.auth.uid, get(/databases/$(database)/documents/travelJournals/$(request.resource.data.postId)).data.authorId)
            && !deleting(authorOf('travelJournals', request.resource.data.postId))
            && linkedCounter('travelJournals', request.resource.data.postId, 'likeCount', 1))));
      allow update: if false;
      allow delete: if notDeleting() && (request.auth != null && resource.data.userId == request.auth.uid
        && likeId == resource.data.postId + '___' + request.auth.uid
        && ((likeKind(resource.data) == 'post' && linkedCounter('travelPosts', resource.data.postId, 'likeCount', -1))
          || (likeKind(resource.data) == 'journal' && linkedCounter('travelJournals', resource.data.postId, 'likeCount', -1))));
    }
    match /savedPosts/{savedId} {
      allow get: if request.auth != null && (resource != null ? resource.data.userId == request.auth.uid : savedId.split('___')[0] == request.auth.uid);
      allow list: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if notDeleting() && (request.auth != null && request.resource.data.userId == request.auth.uid
        && savedId == request.auth.uid + '___' + request.resource.data.postId && readablePost(request.resource.data.postId)
        && !deleting(authorOf('travelPosts', request.resource.data.postId))
        && linkedCounter('travelPosts', request.resource.data.postId, 'saveCount', 1));
      allow update: if notDeleting() && (request.auth != null && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['collectionName']));
      allow delete: if notDeleting() && (request.auth != null && resource.data.userId == request.auth.uid
        && linkedCounter('travelPosts', resource.data.postId, 'saveCount', -1));
    }
    match /follows/{followId} {
      allow read: if request.auth != null;
      allow create: if notDeleting() && (request.auth != null && request.resource.data.followerId == request.auth.uid
        && request.resource.data.followingId != request.auth.uid
        && followId == request.auth.uid + '___' + request.resource.data.followingId
        && unblocked(request.auth.uid, request.resource.data.followingId) && !deleting(request.resource.data.followingId)
        && followLinked(request.resource.data, 1));
      allow update: if false;
      allow delete: if notDeleting() && (request.auth != null && resource.data.followerId == request.auth.uid
        && followId == request.auth.uid + '___' + resource.data.followingId && followLinked(resource.data, -1));
    }
    match /postComments/{commentId} {
      allow read: if request.auth != null && (resource.data.authorId == request.auth.uid || readablePost(resource.data.postId));
      allow create: if notDeleting() && (request.auth != null && request.resource.data.authorId == request.auth.uid
        && readablePost(request.resource.data.postId)
        && unblocked(request.auth.uid, get(/databases/$(database)/documents/travelPosts/$(request.resource.data.postId)).data.authorId)
        && !deleting(authorOf('travelPosts', request.resource.data.postId))
        && (request.resource.data.get('parentCommentId', null) == null
          || !deleting(authorOf('postComments', request.resource.data.parentCommentId)))
        && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 500
        && clean(request.resource.data.text)
        && request.resource.data.replyCount == 0 && request.resource.data.isDeleted == false
        && postCommentLinked(commentId, request.resource.data.postId, 1) && replyLinked(request.resource.data, commentId, 1));
      allow update: if notDeleting() && (request.auth != null && (
        (resource.data.authorId == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'updatedAt'])
          && resource.data.isDeleted == false && request.resource.data.text is string
          && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 500
          && clean(request.resource.data.text) && resource.data.get('moderationRemoved', false) == false)
        || (resource.data.authorId == request.auth.uid && resource.data.isDeleted == false && request.resource.data.isDeleted == true
          && request.resource.data.text == '' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isDeleted', 'text', 'updatedAt'])
          && postCommentLinked(commentId, resource.data.postId, -1) && replyLinked(resource.data, commentId, -1))
        || replyCounter(commentId)
        || (isModerator() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'moderationRemoved', 'moderatedBy', 'moderatedAt'])
          && request.resource.data.text == '' && request.resource.data.moderationRemoved == true
          && request.resource.data.moderatedBy == request.auth.uid && request.resource.data.moderatedAt == request.time)));
      allow delete: if false;
    }

    // ── Account deletion jobs ─────────────────────────────────────────
    // Written only by the server (Admin credentials) during account deletion.
    match /accountDeletions/{uid} {
      allow read, write: if false;
    }

    match /travelerReputation/{uid} {
      allow read: if request.auth != null;
      allow write: if notDeleting() && (request.auth != null && request.auth.uid == uid);
    }
  }
}
