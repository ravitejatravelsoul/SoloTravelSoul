rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Default: deny everything ──────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }

    // ── Users ──────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // ── Trips ─────────────────────────────────────────────────────
      match /trips/{tripId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;

        // ── Itinerary days ─────────────────────────────────────────
        match /itinerary/{dayId} {
          allow read, write: if request.auth != null && request.auth.uid == userId;
        }

        // ── Packing checklist ──────────────────────────────────
        match /checklist/{itemId} {
          allow read, write: if request.auth != null && request.auth.uid == userId;
        }

        // ── Trip reminder preferences ───────────────────────────
        match /reminders/{doc} {
          allow read, write: if request.auth != null && request.auth.uid == userId;
        }
      }

      // ── Saved places ───────────────────────────────────────────────
      match /saved_places/{placeId} {
        allow read, delete: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null
          && request.auth.uid == userId
          && request.resource.data.userId == request.auth.uid;
        allow update: if request.auth != null && request.auth.uid == userId;
      }
    }

    // ── Notifications ─────────────────────────────────────────────────
    match /notifications/{notificationId} {
      allow read: if request.auth != null
        && request.auth.uid == resource.data.userId;

      allow update: if request.auth != null
        && request.auth.uid == resource.data.userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead'])
        && request.resource.data.isRead is bool;
    }

    // ── User place reviews ────────────────────────────────────────────
    match /user_place_reviews/{reviewId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.userId;
      allow update, delete: if request.auth != null
        && request.auth.uid == resource.data.userId;
    }

    // ── User lookup — minimal public data for chat search ────────────
    // Written by owner on profile create/update.
    // Any authenticated user can read for email-based user discovery.
    match /userLookup/{uid} {
      allow read: if request.auth != null;
      // Validate that the stored email matches the caller's verified auth token email.
      // Prevents a user from writing another user's email into their own lookup entry.
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.email.lower() == request.auth.token.email.lower();
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // ── Direct chats ─────────────────────────────────────────────────
    match /direct_chats/{chatId} {
      // resource == null when the document does not yet exist.
      // Allowing authenticated reads on non-existing docs is safe:
      // the SDK returns exists()=false with no data, so nothing is exposed.
      allow read: if request.auth != null
        && (resource == null || request.auth.uid in resource.data.participants);
      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.participants.size() == 2;
      // Participants can update metadata (lastMessage, unreadCounts).
      // The participants array itself must not change after creation.
      allow update: if request.auth != null
        && request.auth.uid in resource.data.participants
        && request.resource.data.participants == resource.data.participants;

      match /messages/{messageId} {
        allow read: if request.auth != null
          && request.auth.uid in
             get(/databases/$(database)/documents/direct_chats/$(chatId)).data.participants;
        allow create: if request.auth != null
          && request.auth.uid in
             get(/databases/$(database)/documents/direct_chats/$(chatId)).data.participants
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 1000;
        // Messages are immutable once sent.
        allow update, delete: if false;
      }
    }

    // ── Groups ────────────────────────────────────────────────────────
    match /groups/{groupId} {
      allow read: if request.auth != null
        && request.auth.uid in resource.data.members;
      // Creator must be a member, and must set themselves as createdBy.
      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.members
        && request.auth.uid == request.resource.data.createdBy;
      // Creator can update any field (rename group, add/remove members, etc.)
      allow update: if request.auth != null
        && request.auth.uid == resource.data.createdBy;
      // Members (non-creator) can only write chat metadata — not group structure
      allow update: if request.auth != null
        && request.auth.uid in resource.data.members
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['lastMessage', 'unreadCounts', 'updatedAt']);
      allow delete: if request.auth != null
        && request.auth.uid == resource.data.createdBy;

      match /messages/{messageId} {
        allow read: if request.auth != null
          && request.auth.uid in
             get(/databases/$(database)/documents/groups/$(groupId)).data.members;
        allow create: if request.auth != null
          && request.auth.uid in
             get(/databases/$(database)/documents/groups/$(groupId)).data.members
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 1000;
        allow update, delete: if false;
      }
    }

    // ── Places cache ──────────────────────────────────────────────────
    match /places_cache/{placeId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.data.id == placeId
        && request.resource.data.source in ['foursquare', 'manual'];
    }

    // ── Community: Public Profiles ────────────────────────────────────
    match /publicProfiles/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // ── Community: Public Trips ───────────────────────────────────────
    match /publicTrips/{tripId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid;
      allow update: if request.auth != null
        && resource != null
        && resource.data.ownerUid == request.auth.uid;
      // Allow delete even when doc doesn't exist (batch delete when trip goes private).
      allow delete: if request.auth != null
        && (resource == null
            || resource.data.ownerUid == request.auth.uid);
    }

    // ── Community: Trip Members subcollection ────────────────────────
    // Write is restricted to the trip owner. Two-phase check handles the
    // batch that creates publicTrips + member doc at the same time.
    match /trips/{tripId}/members/{memberId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && (
        // Phase 1 — initial trip publication: publicTrip doesn't exist yet
        // (same-batch create), so verify via the user's private trips subcollection.
        (!exists(/databases/$(database)/documents/publicTrips/$(tripId))
          && request.resource.data.role == 'owner'
          && request.resource.data.uid == request.auth.uid
          && exists(/databases/$(database)/documents/users/$(request.auth.uid)/trips/$(tripId)))
        ||
        // Phase 2 — join-request approval: publicTrip already exists.
        (exists(/databases/$(database)/documents/publicTrips/$(tripId))
          && get(/databases/$(database)/documents/publicTrips/$(tripId)).data.ownerUid == request.auth.uid)
      );
      allow delete: if request.auth != null && (
        memberId == request.auth.uid   // member removing themselves
        || (exists(/databases/$(database)/documents/publicTrips/$(tripId))
            && get(/databases/$(database)/documents/publicTrips/$(tripId)).data.ownerUid == request.auth.uid)
      );
      allow update: if false;
    }

    // ── Community: Trip Join Requests ─────────────────────────────────
    match /tripJoinRequests/{requestId} {
      allow create: if request.auth != null
        && request.resource.data.requestorUid == request.auth.uid
        && request.resource.data.ownerUid != request.auth.uid
        && request.resource.data.status == 'pending';
      // Allow read when resource == null so getTripJoinRequestStatus returns null
      // instead of throwing permission-denied for trips with no previous request.
      allow read: if request.auth != null
        && (resource == null
            || resource.data.ownerUid == request.auth.uid
            || resource.data.requestorUid == request.auth.uid);
      allow update: if request.auth != null
        && resource != null
        && (
          (resource.data.ownerUid == request.auth.uid
            && request.resource.data.status in ['approved', 'rejected'])
          || (resource.data.requestorUid == request.auth.uid
              && request.resource.data.status == 'cancelled')
        );
      allow delete: if false;
    }

    // ── Community: Travel Groups ──────────────────────────────────────
    match /travelGroups/{groupId} {
      // List/get: public groups readable by all auth users; private groups by owner only.
      allow read: if request.auth != null
        && (resource == null
            || resource.data.visibility == 'public'
            || resource.data.ownerUid == request.auth.uid);
      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid;
      allow update: if request.auth != null
        && resource != null
        && resource.data.ownerUid == request.auth.uid;
      allow delete: if request.auth != null
        && resource != null
        && resource.data.ownerUid == request.auth.uid;

      // Group members: restricted to group owner; two-phase check mirrors trip members.
      match /members/{memberId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && (
          // Phase 1 — group creation batch: group doc doesn't exist yet in Firestore.
          (!exists(/databases/$(database)/documents/travelGroups/$(groupId))
            && request.resource.data.role == 'owner'
            && request.resource.data.uid == request.auth.uid)
          ||
          // Phase 2 — join-request approval: group already exists.
          (exists(/databases/$(database)/documents/travelGroups/$(groupId))
            && get(/databases/$(database)/documents/travelGroups/$(groupId)).data.ownerUid == request.auth.uid)
        );
        allow delete: if request.auth != null && (
          memberId == request.auth.uid   // member leaving themselves
          || (exists(/databases/$(database)/documents/travelGroups/$(groupId))
              && get(/databases/$(database)/documents/travelGroups/$(groupId)).data.ownerUid == request.auth.uid)
        );
        allow update: if false;
      }
    }

    // ── Community: Group Join Requests ────────────────────────────────
    match /groupJoinRequests/{requestId} {
      allow create: if request.auth != null
        && request.resource.data.requestorUid == request.auth.uid
        && request.resource.data.ownerUid != request.auth.uid
        && request.resource.data.status == 'pending';
      // resource == null guard matches tripJoinRequests pattern.
      allow read: if request.auth != null
        && (resource == null
            || resource.data.ownerUid == request.auth.uid
            || resource.data.requestorUid == request.auth.uid);
      allow update: if request.auth != null
        && resource != null
        && (
          (resource.data.ownerUid == request.auth.uid
            && request.resource.data.status in ['approved', 'rejected'])
          || (resource.data.requestorUid == request.auth.uid
              && request.resource.data.status == 'cancelled')
        );
      allow delete: if false;
    }

    // ── Community: Nearby Travelers ───────────────────────────────────
    match /nearbyTravelers/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // ── Community: Activity Feed ──────────────────────────────────────
    match /activityFeed/{feedItemId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.actorUid == request.auth.uid;
      allow delete: if request.auth != null
        && resource.data.actorUid == request.auth.uid;
      allow update: if false;
    }

    // ── Community: Blocks ─────────────────────────────────────────────
    match /blocks/{uid}/blocked/{blockedUid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // ── Community: Reports ────────────────────────────────────────────
    match /reports/{reportId} {
      allow create: if request.auth != null
        && request.resource.data.reporterUid == request.auth.uid;
      allow read: if false;
      allow update, delete: if false;
    }
  }
}
