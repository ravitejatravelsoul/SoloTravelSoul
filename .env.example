# ─────────────────────────────────────────────────────────────────────
# SoloTravelSoul — Environment Variables Template
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to git.
# ─────────────────────────────────────────────────────────────────────

# Firebase — get these from Firebase Console → Project Settings → Your Apps
# These are prefixed EXPO_PUBLIC_ so Expo bundles them into the client.
# Firebase config keys are designed to be client-visible; security comes
# from Firestore rules and App Check, not key secrecy.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# ─────────────────────────────────────────────────────────────────────
# Phase 2 — add only when needed, after MVP is live
# ─────────────────────────────────────────────────────────────────────

# Foursquare Places API (Phase 2 — place search)
# Set ENABLED to "true" only after reviewing the cost controls in docs/PLACE_SEARCH_STRATEGY.md
EXPO_PUBLIC_FOURSQUARE_ENABLED=false
# EXPO_PUBLIC_FOURSQUARE_API_KEY=

# Mapbox (Phase 2 — map view)
# EXPO_PUBLIC_MAPBOX_TOKEN=
