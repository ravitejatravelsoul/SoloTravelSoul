{
  "expo": {
    "name": "SoloTravelSoul",
    "slug": "solotravelsoul",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "solotravelsoul",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "imageWidth": 220,
      "resizeMode": "contain",
      "backgroundColor": "#FFF8EE"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.solotravelsoul.app",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false,
          "NSAllowsLocalNetworking": true
        }
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#FFF8EE"
      },
      "package": "com.solotravelsoul.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.USE_BIOMETRIC",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.USE_EXACT_ALARM",
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "ios": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 220,
            "resizeMode": "contain",
            "backgroundColor": "#FFF8EE"
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#00897B",
          "iosDisplayInForeground": true
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "SoloTravelSoul can use your location while the app is open to sort places by distance. It is optional and is never shared with other travelers.",
          "locationAlwaysAndWhenInUsePermission": "SoloTravelSoul only uses your location while the app is open. It does not track you in the background.",
          "locationAlwaysPermission": "SoloTravelSoul only uses your location while the app is open. It does not track you in the background."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "SoloTravelSoul opens your photo library only when you choose to add a picture to a post, a journal or your profile. Only the photos you pick are used.",
          "cameraPermission": "SoloTravelSoul uses the camera only if you choose to take a new photo for your profile or a post.",
          "microphonePermission": false
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "SoloTravelSoul uses Face ID to unlock a session you are already signed in to. It cannot sign anyone in."
        }
      ],
      "@rnmapbox/maps",
      "./plugins/withFontScaleConfigChange",
      "./plugins/withFontScaleLayoutUpdates"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "1c2e9aa9-0985-4a84-a0b6-426863561807"
      }
    },
    "owner": "ravitejatravelsoul"
  }
}
