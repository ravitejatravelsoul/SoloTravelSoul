{
  "expo": {
    "name": "SoloTravelSoul",
    "slug": "solotravelsoul",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "solotravelsoul",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "imageWidth": 220,
      "resizeMode": "contain",
      "backgroundColor": "#FFF8EE"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.solotravelsoul.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "SoloTravelSoul uses your location to show nearby places and travel recommendations.",
        "NSCameraUsageDescription": "SoloTravelSoul needs camera access to add photos to your travel journal.",
        "NSPhotoLibraryUsageDescription": "SoloTravelSoul needs photo library access to upload journey photos.",
        "NSFaceIDUsageDescription": "Use Face ID to sign in quickly and securely."
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#FFF8EE"
      },
      "package": "com.solotravelsoul.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.USE_BIOMETRIC",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.USE_EXACT_ALARM",
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#00897B",
          "iosDisplayInForeground": true
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "SoloTravelSoul uses your location to show nearby attractions and sort places by distance."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow SoloTravelSoul to access your photos to add memories to your journal.",
          "microphonePermission": false
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow SoloTravelSoul to use Face ID for secure sign-in."
        }
      ],
      "@rnmapbox/maps",
      "./plugins/withFontScaleConfigChange",
      "./plugins/withFontScaleLayoutUpdates"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "1c2e9aa9-0985-4a84-a0b6-426863561807"
      }
    },
    "owner": "ravitejatravelsoul"
  }
}
