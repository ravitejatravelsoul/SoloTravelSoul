# ─────────────────────────────────────────────────────────────────────
# SoloTravelSoul — Expo environment variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to git (it is already in .gitignore).
#
# HOW TO GET THESE VALUES:
#   1. Go to https://console.firebase.google.com
#   2. Select project: solotravelsoul-57a9e
#   3. Click the gear icon → Project Settings
#   4. Scroll to "Your apps" → click your Web app (</> icon)
#   5. Copy the firebaseConfig object values below
#
# NOTE: EXPO_PUBLIC_FIREBASE_API_KEY is the Firebase Web API key.
#       It is NOT the Google Places API key.
# ─────────────────────────────────────────────────────────────────────

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# ─────────────────────────────────────────────────────────────────────
# Phase 2 — add only when needed, after MVP is live
# ─────────────────────────────────────────────────────────────────────

# ─────────────────────────────────────────────────────────────────────
# Image storage provider — see docs/R2_STORAGE_SETUP.md
# ─────────────────────────────────────────────────────────────────────
# 'r2'      → Cloudflare R2 via Worker (recommended, no Blaze needed)
# 'firebase' → Firebase Storage (requires Blaze plan)
# (empty)   → photo uploads disabled, shows "coming soon"
EXPO_PUBLIC_STORAGE_PROVIDER=r2

# Required when EXPO_PUBLIC_STORAGE_PROVIDER=r2
# Set to the deployed Worker URL from: wrangler deploy
# Example: https://solotravelsoul-r2-upload.your-subdomain.workers.dev
EXPO_PUBLIC_R2_UPLOAD_WORKER_URL=

# Foursquare Places API (place search — free tier)
# Get key at: https://foursquare.com/developers/
EXPO_PUBLIC_FOURSQUARE_ENABLED=false
# EXPO_PUBLIC_FOURSQUARE_API_KEY=

# ─────────────────────────────────────────────────────────────────────
# Mapbox native map
# IMPORTANT: requires an EAS dev/production build — never activates in Expo Go.
# In Expo Go, the app uses WebLeafletMap (OpenStreetMap) instead.
#
# To activate native Mapbox:
#   1. Create a free Mapbox account at https://account.mapbox.com/
#   2. Create a public token (pk.eyJ1...) — used at runtime
#   3. Create a secret downloads token (sk.eyJ1...) — used only at Android build time
#   4. Set the two env vars below to real values
#   5. Add secrets for EAS builds (see docs/MAP_STRATEGY.md for exact commands)
#   6. Run: eas build --profile development --platform ios   (or android)
#   7. Install the dev build on device — do NOT open in Expo Go
# ─────────────────────────────────────────────────────────────────────
EXPO_PUBLIC_MAPBOX_ENABLED=false
# EXPO_PUBLIC_MAPBOX_TOKEN=pk.eyJ1...
