# ─────────────────────────────────────────────────────────────────────
# SoloTravelSoul — Expo environment variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to git (it is already in .gitignore).
#
# HOW TO GET THESE VALUES:
#   1. Go to https://console.firebase.google.com
#   2. Select project: solotravelsoul-57a9e
#   3. Click the gear icon → Project Settings
#   4. Scroll to "Your apps" → click your Web app (</> icon)
#   5. Copy the firebaseConfig object values below
#
# NOTE: EXPO_PUBLIC_FIREBASE_API_KEY is the Firebase Web API key.
#       It is NOT the Google Places API key.
# ─────────────────────────────────────────────────────────────────────

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# ─────────────────────────────────────────────────────────────────────
# Phase 2 — add only when needed, after MVP is live
# ─────────────────────────────────────────────────────────────────────

# Foursquare Places API (place search — free tier)
# Get key at: https://foursquare.com/developers/
# EXPO_PUBLIC_FOURSQUARE_API_KEY=

# Mapbox (interactive map view)
# IMPORTANT: Mapbox requires an EAS development build — it does NOT work in Expo Go.
#
# In Expo Go (npx expo start):
#   → MapPlaceholder and TripMapFallback render instead of the real map.
#   → No native module is imported. App will not crash.
#
# To enable the real map:
#   1. Create a free account at https://account.mapbox.com/
#   2. Create a public token (starts with pk.eyJ1...)
#   3. For Android: also create a secret download token (starts with sk.)
#      and add it to eas.json under env: { MAPBOX_DOWNLOADS_TOKEN: "sk...." }
#   4. Set both env vars below to real values
#   5. Run one of:
#        eas build --profile development --platform ios
#        eas build --profile development --platform android
#   6. Install the .ipa / .apk on your device (not Expo Go)
#   7. The real Mapbox map will appear in Discover → Map and Itinerary → Map
#
# EXPO_PUBLIC_MAPBOX_TOKEN=pk.eyJ1IjoiWU9VUi1VU0VSTkFNRSIsImEiOiJ...
# EXPO_PUBLIC_MAPBOX_ENABLED=false
