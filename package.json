{
  "name": "solotravelsoul",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@11.6.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo build",
    "lint": "turbo lint",
    "type-check": "turbo type-check",
    "mobile": "npm run dev --workspace=apps/mobile",
    "mobile:android": "cd apps/mobile && npx expo run:android",
    "clean": "turbo clean",
    "test:release": "node tests/release/queues.cjs",
    "test:rules": "firebase emulators:exec --project demo-sts-release-review --only firestore --config firebase.test.json \"node tests/release/rules.cjs\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "firebase-admin": "^13.10.0",
    "tsx": "^4.22.4",
    "turbo": "^2.3.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
