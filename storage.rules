rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // ── Default: deny everything ──────────────────────────────────────
    match /{allPaths=**} {
      allow read, write: if false;
    }

    // ── Profile photos ────────────────────────────────────────────────
    // Any authenticated user can read profile photos — avatars appear in
    // public profiles, chat lists, join requests, etc. Only the owner
    // can upload (write) their own avatar.
    match /profile_photos/{uid}/{fileName} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // ── Trip cover photos ─────────────────────────────────────────────
    match /trip_covers/{uid}/{fileName} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // ── Journal photos ────────────────────────────────────────────────
    match /journals/{uid}/{tripId}/{fileName} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
